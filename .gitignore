.DS_Store
*.conf
*.iml
*.ipr
*.iws
.idea/

# Playwright web-UI test harness runtime (installed into tests/webui/ on first
# `npm install`; not checked in).
tests/webui/node_modules/
tests/webui/package-lock.json
tests/webui/test-results/
tests/webui/playwright-report/

# Local pi-gen image build output (created by tools/build-image.sh)
deploy/
.pi-gen-build/

# Stray local files (screenshots, etc.)
*.jpg
*.jpeg

# Python compile cache produced by `python3 -m py_compile`
__pycache__/
*.pyc

# Cloud viewer (#1035): local Docker runtime secrets/data. The nginx conf is
# tracked, so re-include it past the broad *.conf ignore above.
.env
local-TeslaCam/
gcs-service-account.json
!docker/nginx-cloudviewer.conf
